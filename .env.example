# Example environment variables for the URL Shortener.
# Copy to `.env` when running locally and fill in real values.
# `.env` is git-ignored and must NEVER be committed.

# --- Application ---
SERVER_PORT=8080
# Public origin used to build short URLs (e.g. https://short.ly in production).
BASE_URL=http://localhost:8080

# --- PostgreSQL (Phase 2 — database layer) ---
# These map directly to the datasource in application.yml. No secrets are
# committed; set real values locally / in your container environment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urlshortener
DB_USERNAME=replace-me
DB_PASSWORD=change-me

# --- Redis (Phase 5 — cache-aside layer) ---
# Redis is a performance layer only; PostgreSQL stays the source of truth.
# If Redis is unavailable the app still works (falls back to the database).
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional username for ACL-based providers (e.g. Upstash Redis uses "default").
# Leave empty when Redis requires only a password / has no username.
REDIS_USERNAME=
# Leave empty when Redis has no password configured.
REDIS_PASSWORD=
# Set to true when the provider only accepts TLS on this port (e.g. Upstash, *.upstash.io).
REDIS_SSL_ENABLED=false
REDIS_CONNECTION_TIMEOUT=2000
REDIS_COMMAND_TIMEOUT=2000
# Cache key prefix and max entry TTL (ISO-8601). Live TTL for an expiring link is
# min(expiresAt - now, CACHE_URL_TTL); a never-expiring link uses CACHE_URL_TTL.
CACHE_KEY_PREFIX=url:
CACHE_URL_TTL=PT168H

# --- Kafka (Phase 8 — async click analytics) ---
# Broker for the click-events topic. The redirect is fire-and-forget: a Kafka
# outage never blocks a 302. Set APP_KAFKA_ENABLED=false to run without a broker.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# APP_KAFKA_CLICK_TOPIC=url-click-events
# APP_KAFKA_CONSUMER_GROUP=url-analytics
# APP_KAFKA_ENABLED=true

# --- JWT (Phase 6 — authentication) ---
# Secret used to sign/verify HS256 access tokens. MUST be at least 32 bytes and
# changed in production; the app fails to start if it is missing or too short.
# Never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
# Access-token lifetime in minutes (short-lived by default).
JWT_EXPIRATION_MINUTES=15
# Comma-separated list of allowed CORS origins. Empty = no cross-origin calls.
# Never use "*" alongside credentials.
CORS_ALLOWED_ORIGINS=

# --- Rate limiting (Phase 9) ---
# Fixed-window counters stored in Redis under "rate-limit:{scope}:{identifier}"
# (never the URL cache keys). Redis failures FAIL OPEN: requests are allowed and a
# warning is logged — an outage never causes a 500. Set APP_RATE_LIMIT_ENABLED=false
# to disable rate limiting entirely.
APP_RATE_LIMIT_ENABLED=true
# Window length (ISO-8601 duration), e.g. PT60S = 60 seconds.
APP_RATE_LIMIT_WINDOW=PT60S
# Max requests per window for the most abuse-prone endpoints.
APP_RATE_LIMIT_CREATE_URL=30
APP_RATE_LIMIT_LOGIN=10
APP_RATE_LIMIT_REGISTER=5
# Redirect-path limiting is OFF by default: the redirect is the performance-critical
# path and must not pay a limiter lookup unless you explicitly enable it.
APP_RATE_LIMIT_REDIRECT_ENABLED=false
APP_RATE_LIMIT_REDIRECT_LIMIT=60
# Redis key namespace prefix for rate-limit counters.
APP_RATE_LIMIT_PREFIX=rate-limit: