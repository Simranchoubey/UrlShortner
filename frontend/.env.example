# Base URL of the Spring Boot backend the frontend talks to.
# Copy this file to `.env` and adjust for your environment.
VITE_API_BASE_URL=http://localhost:8080

# Frontend dev server origin (used only for display / optimistic short URLs is NOT
# used — the backend returns the canonical shortUrl in every response).
# Frontend dev server is started by Vite on http://localhost:5173 by default.